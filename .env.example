# ── LM Studio (default provider) ─────────────────────────────────────────────
# LM Studio is the default provider for chat, summarization, and embeddings.
# The OpenAI-compatible server URL and the model ids are configurable:
NEURAL_OPENAI_COMPATIBLE_URL=http://127.0.0.1:1234/v1
# NEURAL_OPENAI_COMPATIBLE_MODEL=qwen/qwen3.5-9b
# NEURAL_OPENAI_COMPATIBLE_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5@q8_0
# NEURAL_OPENAI_COMPATIBLE_API_KEY=

# Optional calendar OAuth configuration.
# The application remains fully local when these values are absent.
NEURAL_GOOGLE_CLIENT_ID=
NEURAL_GOOGLE_CLIENT_SECRET=
NEURAL_MICROSOFT_CLIENT_ID=
NEURAL_MICROSOFT_CLIENT_SECRET=

# Optional local model endpoints.
NEURAL_OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Whisper-compatible CLI used for transcription (openai-whisper,
# faster-whisper, whisper.cpp, or a wrapper). Resolved via this variable,
# well-known install locations (/opt/homebrew/bin, /usr/local/bin, ...), then
# PATH. The CLI must accept: <audio> --language LANG --model MODEL
# --output_format json --output_dir DIR and write <stem>.json.
NEURAL_WHISPER_BIN=whisper

# Optional: model to pass to the whisper CLI (defaults to the workspace's
# transcription route, then "small").
# NEURAL_WHISPER_MODEL=

# Hugging Face CLI used by the Models tab "Download" for local models
# (`hf` or `huggingface-cli`); resolved via this variable, known locations,
# then PATH.
# NEURAL_HF_BIN=

# Optional HF cache root for model downloads. When unset the HF CLI uses its
# standard resolution (HF_HOME, then ~/.cache/huggingface).
# NEURAL_HF_HOME=
