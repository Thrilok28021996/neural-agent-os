{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neural Agent OS",
  "version": "0.1.0",
  "identifier": "os.neuralagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neural Agent OS",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "wix": {}
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.neural-agent.os/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3QzE4MUY0NUY3NkJFN0QKUldSOXZuWmY5SUhCcDR4V1Z6a2E0RFA5R2dubWllVW9MeUw4S0tKM1dSVXBNdWtBa1lXSW51WVoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}